# Local PostgreSQL Database configuration (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vms_db

# Server-only HikCentral OpenAPI V3.1.1 configuration
HIKCENTRAL_BASE_URL=https://127.0.0.1:443
HIKCENTRAL_APP_KEY=your-app-key
HIKCENTRAL_APP_SECRET=your-app-secret
HIKCENTRAL_USER_ID=admin

# Optional HTTP/TLS settings (for on-prem self-signed certificates, prefer HIKCENTRAL_CA_CERT in production)
# HIKCENTRAL_TIMEOUT_MS=10000
# HIKCENTRAL_TLS_INSECURE=false
# HIKCENTRAL_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

